# 镜像仓库地址不带标签。Compose 从同一仓库拉取 <版本>-api 和 <版本>-web。
# 例如 IMAGE_REPOSITORY=registry.example.com/team/purchase-platform，IMAGE_TAG=v1.0.0。
IMAGE_REPOSITORY=docker.io/5267zh/purchase-platform
IMAGE_TAG=v1.0.0

# 为下面三个变量分别运行 openssl rand -hex 32 并填入结果。
# MYSQL_PASSWORD 使用十六进制，这样可以直接放进 DATABASE_URL。
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
INTERNAL_JOB_TOKEN=

# 仅在使用 compose.public.yaml 时填写。
SITE_DOMAIN=
SITE_USER=
# 整个哈希用单引号包住，避免 Compose 展开其中的 $。
SITE_PASSWORD_HASH=''
